# PostgreSQL connection string (hosted Postgres e.g. Neon, Railway, Render, RDS, or local Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Optional isolated database URL used by `npm test` PostgreSQL integration specs
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DBNAME

# API server settings
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:8080
APP_BASE_URL=http://localhost:8080
TRUST_PROXY=false
NODE_ENV=development

# Session cookie settings (change AUTH_COOKIE_SECRET to >=32 random chars in production)
AUTH_COOKIE_SECRET=change-me-in-production-use-at-least-32-random-chars
SESSION_COOKIE_NAME=erp_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=auto

# Optional SMTP transactional email delivery (password resets, approvals, overdue/expiry digests)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Count It Keep It ERP <notifications@example.com>"

# Container / deploy helper (run Drizzle migrations automatically on boot when true)
RUN_MIGRATIONS=false
