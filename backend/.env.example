# PostgreSQL connection string (hosted Postgres e.g. Neon, Railway, Render, RDS, or local Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Optional isolated database URL used by `npm test` PostgreSQL integration specs
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DBNAME

# API server settings
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:8080
APP_BASE_URL=http://localhost:8080
TRUST_PROXY=false
NODE_ENV=development

# Session cookie settings (change AUTH_COOKIE_SECRET to >=32 random chars in production)
AUTH_COOKIE_SECRET=change-me-in-production-use-at-least-32-random-chars
# 32-byte hex (64 hex chars) or base64 key for TOTP 2FA secret encryption (required in production)
# MFA_ENCRYPTION_KEY=
# MFA_ENCRYPTION_KEY_VERSION=1
# MFA_ENCRYPTION_PREVIOUS_KEYS=
SESSION_COOKIE_NAME=erp_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=auto

# Auth rate limiting & temporary lockout controls
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_MFA_RATE_LIMIT_MAX=10
# AUTH_MFA_RATE_LIMIT_WINDOW_MS=60000
# AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=10
# AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
# AUTH_LOCKOUT_MAX_ATTEMPTS=5
# AUTH_LOCKOUT_WINDOW_MS=900000
# AUTH_LOCKOUT_DURATION_MS=900000

# Optional ClamAV virus-scan hook for uploaded attachments (off by default)
# ATTACHMENT_VIRUS_SCAN_ENABLED=false
# ATTACHMENT_VIRUS_SCAN_CLAMAV_HOST=127.0.0.1
# ATTACHMENT_VIRUS_SCAN_CLAMAV_PORT=3310
# ATTACHMENT_VIRUS_SCAN_TIMEOUT_MS=10000
# ATTACHMENT_VIRUS_SCAN_FAIL_CLOSED=true

# Pluggable document attachment storage (local | s3)
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/app/uploads
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Optional SMTP transactional email delivery (password resets, approvals, overdue/expiry digests)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Count It Keep It ERP <notifications@example.com>"

# Structured Pino logging level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Optional Egyptian Tax Authority (مصلحة الضرائب المصرية / ETA e-Receipt v1.2) credentials
# ETA_CLIENT_ID=
# ETA_CLIENT_SECRET=
# ETA_ID_BASE_URL=https://id.preprod.eta.gov.eg
# ETA_API_BASE_URL=https://api.preprod.invoicing.eta.gov.eg

# Container / deploy helper (run Drizzle migrations automatically on boot when true)
RUN_MIGRATIONS=false

# Prometheus /api/metrics bearer token (required in production; endpoint returns 404 when unset)
# METRICS_TOKEN=

# Optional Sentry error tracking (backend + frontend VITE_SENTRY_* build-time vars)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
# Note: Frontend Sentry uses VITE_SENTRY_DSN and VITE_SENTRY_ENVIRONMENT at Vite build time.
