# ==============================================================================
# Count It Keep It ERP — Production Environment Template
# Copy to .env on your VPS (chmod 600 .env) and replace placeholder values.
# NEVER commit a populated .env file to version control.
# ==============================================================================

# Public domain handled by Caddy automatic Let's Encrypt HTTPS
SITE_ADDRESS=erp.example.com

# Prebuilt GHCR container images (pinned automatically during CD deploys)
BACKEND_IMAGE=ghcr.io/abdallahgama1/erp-system-backend:latest
FRONTEND_IMAGE=ghcr.io/abdallahgama1/erp-system-frontend:latest

# Managed PostgreSQL connection string (Neon pooled/direct or AWS RDS with SSL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Optional: direct (non-pooler) PostgreSQL URL for pg_dump / pg_restore & Neon migrations
DIRECT_DATABASE_URL=

# Cryptographic cookie signing secret (required >= 32 chars). Generate with:
#   openssl rand -hex 32
AUTH_COOKIE_SECRET=replace-with-at-least-32-chars-random-secret

# 32-byte hex (64 hex chars) or base64 key for TOTP 2FA secret encryption (required in production).
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=replace-with-64-hex-chars-mfa-encryption-key
MFA_ENCRYPTION_KEY_VERSION=1
# Comma-separated 'version:key' pairs or JSON '{"1":"<hex>"}' kept during key rotation
MFA_ENCRYPTION_PREVIOUS_KEYS=

# Auth rate limiting & temporary lockout controls
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_MFA_RATE_LIMIT_MAX=10
AUTH_MFA_RATE_LIMIT_WINDOW_MS=60000
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=10
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_DURATION_MS=900000

# Optional ClamAV virus-scan hook for uploaded attachments (off by default)
ATTACHMENT_VIRUS_SCAN_ENABLED=false
ATTACHMENT_VIRUS_SCAN_CLAMAV_HOST=127.0.0.1
ATTACHMENT_VIRUS_SCAN_CLAMAV_PORT=3310
ATTACHMENT_VIRUS_SCAN_TIMEOUT_MS=10000
ATTACHMENT_VIRUS_SCAN_FAIL_CLOSED=true

# Pluggable document attachment storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Browser CORS & external app base URL (must match your public HTTPS SITE_ADDRESS)
CORS_ORIGIN=https://erp.example.com
APP_BASE_URL=https://erp.example.com

# Session, proxy & runtime controls
COOKIE_SECURE=auto
TRUST_PROXY=true
RUN_MIGRATIONS=true
LOG_LEVEL=info
SESSION_COOKIE_NAME=erp_session
SESSION_TTL_DAYS=30

# Prometheus /api/metrics bearer token (404 in prod if unset). Generate with:
#   openssl rand -hex 24
METRICS_TOKEN=

# Optional Sentry observability (scrubbed automatically before transmission)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Optional frontend build-time variables (also configurable via GitHub repo/env vars)
VITE_API_BASE_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Optional SMTP credentials for password resets and operational alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Count It Keep It ERP <no-reply@erp.example.com>

# Optional Egyptian Tax Authority (ETA) e-Receipt v1.2 credentials
# Use https://id.eta.gov.eg & https://api.invoicing.eta.gov.eg for ETA Production
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_ID_BASE_URL=https://id.preprod.eta.gov.eg
ETA_API_BASE_URL=https://api.preprod.invoicing.eta.gov.eg

# Pre-deploy & scheduled backup controls (used by scripts/deploy.sh & backup-db.sh)
PRE_DEPLOY_BACKUP=true
BACKUP_DIR=/var/backups/count-it-keep-it
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=5
