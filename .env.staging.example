# ==============================================================================
# Count It Keep It ERP — Staging Environment Template
# Copy to .env.staging (chmod 600 .env.staging) and replace placeholder values.
# NEVER reuse production secrets or production DATABASE_URL in staging.
# ==============================================================================

SITE_ADDRESS=staging.erp.example.com

BACKEND_IMAGE=ghcr.io/abdallahgama1/erp-system-backend:latest
FRONTEND_IMAGE=ghcr.io/abdallahgama1/erp-system-frontend:latest

# Isolated internal PostgreSQL 18 container (docker-compose.staging.yml)
POSTGRES_USER=erp_staging
POSTGRES_PASSWORD=replace-with-staging-postgres-password
POSTGRES_DB=erp_staging
DATABASE_URL=postgresql://erp_staging:replace-with-staging-postgres-password@postgres-staging:5432/erp_staging

# Staging-only cryptographic secrets (generate with: openssl rand -hex 32)
AUTH_COOKIE_SECRET=replace-with-staging-cookie-secret-at-least-32-chars
MFA_ENCRYPTION_KEY=replace-with-staging-64-hex-chars-mfa-encryption-key
MFA_ENCRYPTION_KEY_VERSION=1
MFA_ENCRYPTION_PREVIOUS_KEYS=

CORS_ORIGIN=https://staging.erp.example.com
APP_BASE_URL=https://staging.erp.example.com
COOKIE_SECURE=auto
TRUST_PROXY=true
RUN_MIGRATIONS=true
LOG_LEVEL=info

# Staging backup & freshness settings (separate prefix from production)
PRE_DEPLOY_BACKUP=true
BACKUP_DIR=/var/backups/count-it-keep-it-staging
BACKUP_RETENTION_DAYS=7
BACKUP_MIN_KEEP=3
BACKUP_MAX_AGE_HOURS=26
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_PREFIX=backups/count-it-keep-it-staging
BACKUP_ENCRYPTION_KEY=

# Optional smoke-test admin credentials (used by scripts/deploy.sh + scripts/smoke-test.mjs)
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=

# Observability
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
VITE_SENTRY_ENVIRONMENT=staging

# ETA Egypt Pre-Production ONLY (never point staging at production ETA)
ETA_ID_BASE_URL=https://id.preprod.eta.gov.eg
ETA_API_BASE_URL=https://api.preprod.invoicing.eta.gov.eg
ETA_INVOICE_VERSION=0.9
